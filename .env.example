# Full path to the Tesseract OCR executable.
# Only needed if tesseract is not on your PATH.
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Seconds between captures in window-capture mode.
CAPTURE_INTERVAL_SEC=1

# Frames per second for region capture (video/frames mode).
CAPTURE_FPS=15

# Base directory where captures are written.
OUTPUT_DIR=captures

# Subdirectory (under OUTPUT_DIR) for saved frame images.
FRAMES_DIR=frames

# Subdirectory (under OUTPUT_DIR) for saved OCR text output.
TEXTS_DIR=texts

# OpenAI API key, used by src/predictor.py to predict the next detected
# multiplier in run_detection(). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
